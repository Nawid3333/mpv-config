# mpv's own files and yt-dlp.exe (2026-10-03): not kept in git. mpv-build.json
# pins the build (CI moves the pin), installer/install-mpv.ps1 - run by
# updater.bat - installs it; updater.bat also keeps yt-dlp.exe current.
# The list is mpv-build.json's upstream_files; a build that ships a file not
# covered here is refused by mpv-auto-update.yml until it is added.
/mpv.exe
/mpv.com
/d3dcompiler_43.dll
/doc/manual.pdf
/doc/mpbindings.png
/installer/mpv-icon.ico
/installer/mpv-install.bat
/installer/mpv-uninstall.bat
/mpv-register.bat
/mpv-unregister.bat
/mpv/
/yt-dlp.exe
# what an install or download cut short leaves next to them: install-mpv.ps1
# copies each file in through <name>.new, update.ps1 downloads yt-dlp.exe to
# yt-dlp.exe.part. Not ignored, a `git add -A` took them in as plain blobs
# (*.exe.new is no *.exe for Git LFS: ~120 MB that GitHub refuses).
*.new
*.part
# what the one-click install (installer/setup.ps1, 2026-10-09) writes into the
# folder it installs - never a clone: the list of files it installed, and a file
# you had changed, set aside before an update replaced it
/.install-manifest.json
*.mine-*
# left by shinchiro's updater in installs from before 2026-10-03
/installer/updater.ps1
/updater.ps1
/settings.xml
/7z/*.7z

# Shader cache (auto-generated by mpv)
portable_config/cache/

# remember-speed.lua state (last playback speed; mpv rewrites it on every
# speed change, so a committed copy would immediately go stale)
portable_config/speed.json

# gpu-toggles.lua state (the Movie sharpness menu's choice; 2026-10-02)
portable_config/movie-sharpness.json

# stream-resume.lua state (FastStream playback positions, 7-day expiry;
# rewritten every few seconds during playback)
portable_config/stream-resume.json
portable_config/stream-resume.json.tmp
# the per-process temp files the state files are written through (2026-10-02)
portable_config/*.tmp

# the shader-cache capture (2026-09-26 to 2026-10-05: shaders real playback still
# compiled, with titles) and the cases learned from it: nothing writes them any more,
# but an old copy may still be in a config folder, and must never be committed
portable_config/shader-misses.log
portable_config/shader-cases.json
portable_config/shader-cases.json.tmp

# Log files
*.log

# Locally downloaded test videos
*.mp4
*.webm
*.mkv
*.avi
*.mov
*.7z
*.zip
# ...but the warm-up's Dolby Vision clips ship (shader-cache/clips/README.txt)
!portable_config/Scripts/shader-cache/clips/*.mp4
# Local test material + probe/benchmark scripts (see test-media/README.txt)
test-media/

# Python venv (unused since RIFE was removed 2026-09-20; formerly the whole
# RIFE stack: vapoursynth, vsncnn.dll, vsmlrt.py, models/rife/*.onnx)
.venv/

# Privacy (2026-10-03, before the repo went public): what mpv and its tools
# write while you watch names what was watched, and from where. None of it
# belongs in git.
# mpv's watch-later saves (Q / menu "Save position now"; in portable mode
# ~~state is portable_config) and its optional watch history
portable_config/watch_later/
portable_config/watch_history.jsonl
# screenshots go to the folder mpv was started from (default name mpv-shot%n)
mpv-shot*
# yt-dlp reads yt-dlp.conf next to yt-dlp.exe - it can hold account
# credentials; exported browser cookies likewise
/yt-dlp.conf
*cookies*.txt
# Windows shortcuts store absolute paths, the user name included
*.lnk
# notes at the repo root (todo lists, plans) stay local
/*.txt
# secrets
.env
.env.*
*.pem
*.key
# editor files beyond the shared settings (launch configs hold local paths)
.vscode/*
!.vscode/settings.json
# Claude Code's per-clone settings (permissions name local paths)
.claude/settings.local.json
# linter caches
.ruff_cache/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
__pycache__/
