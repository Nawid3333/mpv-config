#!/bin/sh
# After a pull (2026-10-03): mpv's own files are not in git, so a pull that
# moves mpv-build.json's pin - CI does that for every new mpv build that passes
# the tests - does not change mpv.exe by itself. Say so when the installed
# mpv.exe is not the pinned one (or is missing, e.g. right after the pull that
# took the binaries out of git): updater.bat installs it.
# (Until 2026-10-03 this put back mpv's files when a pull deleted them.)
if [ -f mpv-build.json ]; then
	want=$(tr -d '\r' < mpv-build.json | sed -n 's/^ *"mpv\.exe": *"\([0-9a-f]\{64\}\)".*/\1/p')
	tag=$(tr -d '\r' < mpv-build.json | sed -n 's/^ *"tag": *"\([^"]*\)".*/\1/p')
	have=''
	[ -f mpv.exe ] && have=$(sha256sum mpv.exe | cut -d' ' -f1)
	if [ -n "$want" ] && [ "$have" != "$want" ]; then
		{
			echo
			if [ -z "$have" ]; then
				echo "mpv is not installed in this folder. mpv-build.json pins mpv $tag:"
			else
				echo "The installed mpv.exe is not the pinned mpv $tag."
			fi
			echo "  run updater.bat   (or: pwsh installer/install-mpv.ps1)"
			echo
		} >&2
	fi
fi

# git-lfs's own post-merge, as git lfs install writes it.
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-merge' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-merge "$@"
